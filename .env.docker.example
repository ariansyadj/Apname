# Contoh .env untuk Apname Docker — SALIN ke .env di server Docker, lalu isi.
# JANGAN commit file .env, JANGAN kirim isinya lewat chat.
# Semua nilai di bawah hanya placeholder, kecuali DATABASE_URL internal
# yang memang mengarah ke service db di docker-compose.yml.

# Database internal Docker (ubah hanya passwordnya).
POSTGRES_DB=apname
POSTGRES_USER=apname
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_ACAK_YANG_KUAT

# URL database internal. Ganti bagian passwordnya dengan nilai yang sama
# dengan POSTGRES_PASSWORD di atas.
DATABASE_URL=postgresql://apname:GANTI_DENGAN_PASSWORD_ACAK_YANG_KUAT@db:5432/apname

# Secret JWT backend. Buat acak yang panjang, misal:
#   openssl rand -base64 32
# Kalau secret ini diganti, semua sesi login lama terputus dan harus
# login ulang — itu normal dan lebih aman.
APNAME_JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_YANG_PANJANG

# Sync iNOX terjadwal backend (opsional, kosongkan bila tidak dipakai).
# Username/password iNOX di sini HANYA untuk sync backend, bukan untuk
# login aplikasi. Jangan pakai password yang sama dengan akun lain.
INOX_USERNAME=
INOX_PASSWORD=
SYNC_INTERVAL_MIN=30
