# Copy ke .env untuk lokal, atau isi di Netlify (Site settings -> Environment
# variables) untuk produksi. JANGAN commit file .env yang berisi nilai asli.
# Frontend (Vite, hanya anon key yang aman tampil di browser):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Secrets Edge Function (hanya di dashboard Supabase -> Edge Functions ->
# Secrets, BUKAN di frontend, BUKAN di Netlify, BUKAN di git):
# INOX_USERNAME=username-inox-anda
# INOX_PASSWORD=password-inox-anda (hanya di secrets, jangan ditulis di chat/kode)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-anda (hanya di secrets Edge Function)
