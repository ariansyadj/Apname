# Copy to .env for a live Supabase project. Never commit a real .env.
# Frontend (Vite, public anon key only):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Edge Function secrets (set in Supabase dashboard, NOT in the frontend):
# INOX_USERNAME=
# INOX_PASSWORD=
